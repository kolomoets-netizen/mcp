# Base URL of Confluence API exposed by miniapp-bff proxy.
# Example: https://miniapp-bff.example.com/api/confluence
CONFLUENCE_BFF_URL=

# Personal access token or API token for Confluence (via BFF or direct).
CONFLUENCE_API_TOKEN=

# Optional: set to "false" only for internal/self-signed certificates.
CONFLUENCE_SSL_VERIFY=true

# Optional: comma-separated space keys to limit search scope.
# CONFLUENCE_SPACES_FILTER=DEV,TEAM
